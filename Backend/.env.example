NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

LOG_LEVEL=info

JWT_ACCESS_SECRET=replace_with_long_random_string_at_least_20_chars
JWT_REFRESH_SECRET=replace_with_long_random_string_at_least_20_chars

PADDLE_API_KEY=pdl_live_or_test_key
PADDLE_WEBHOOK_SECRET=paddle_webhook_secret
PADDLE_CHECKOUT_URL=https://checkout.example.com/paddle
PADDLE_RETURN_URL=https://example.com/checkout/return

FIREBASE_PROJECT_ID=store-cuzzycrew-com
FIREBASE_SERVICE_ACCOUNT_PATH=store-cuzzycrew-com-firebase-adminsdk-xxxx.json
FIREBASE_SERVICE_ACCOUNT_JSON=

RATE_LIMIT_GLOBAL_MAX=600
